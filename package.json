{
  "name": "peeps-svg-constructor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:files && npm run test:unit && npm run test:e2e && npm run test:file-ui",
    "test:files": "node --test server/projectStorage.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:file-ui": "playwright test --config playwright.files.config.ts",
    "test:svg": "vitest run src/tests/svg src/tests/roundtrip.test.ts src/tests/compositionExport.test.ts",
    "test:components": "playwright test component-extraction.spec.ts svg-selection.spec.ts",
    "test:composition": "playwright test composition-transforms.spec.ts composition-lifecycle.spec.ts",
    "test:libraries": "playwright test libraries.spec.ts",
    "test:preview": "npm run build && node scripts/verify-build.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "paper": "^0.12.20",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "^9.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^4.1.12"
  }
}
